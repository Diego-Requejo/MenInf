<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         version="6.0">

    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

    <servlet>
        <servlet-name>InicioSesion</servlet-name>
        <servlet-class>controlador.InicioSesion</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>InicioSesion</servlet-name>
        <url-pattern>/InicioSesion</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>RegistrarUsuario</servlet-name>
        <servlet-class>controlador.RegistrarUsuario</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RegistrarUsuario</servlet-name>
        <url-pattern>/RegistrarUsuario</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>CerrarSesion</servlet-name>
        <servlet-class>controlador.CerrarSesion</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CerrarSesion</servlet-name>
        <url-pattern>/CerrarSesion</url-pattern>
    </servlet-mapping>
    
    <servlet>
        <servlet-name>ComprobarSesion</servlet-name>
        <servlet-class>controlador.ComprobarSesion</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>ComprobarSesion</servlet-name>
        <url-pattern>/ComprobarSesion</url-pattern>
    </servlet-mapping>

</web-app>