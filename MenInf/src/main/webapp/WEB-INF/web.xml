<?xml version="1.0" encoding="UTF-8"?>
<web-app version="6.0" xmlns="https://jakarta.ee/xml/ns/jakartaee">
    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>
    <servlet>
        <servlet-name>InicioSesion</servlet-name>
        <servlet-class>controlador.InicioSesion</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>InicioSesion</servlet-name>
        <url-pattern>/InicioSesion</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>RegistrarUsuario</servlet-name>
        <servlet-class>controlador.RegistrarUsuario</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RegistrarUsuario</servlet-name>
        <url-pattern>/RegistrarUsuario</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>CerrarSesion</servlet-name>
        <servlet-class>controlador.CerrarSesion</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CerrarSesion</servlet-name>
        <url-pattern>/CerrarSesion</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>ComprobarSesion</servlet-name>
        <servlet-class>controlador.ComprobarSesion</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ComprobarSesion</servlet-name>
        <url-pattern>/ComprobarSesion</url-pattern>
    </servlet-mapping>
    <!-- Asignaturas -->
    <servlet>
        <servlet-name>ObtenerAsignatura</servlet-name>
        <servlet-class>controlador.ObtenerAsignatura</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ObtenerAsignatura</servlet-name>
        <url-pattern>/ObtenerAsignatura</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>ListarAsignaturas</servlet-name>
        <servlet-class>controlador.ListarAsignaturas</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ListarAsignaturas</servlet-name>
        <url-pattern>/ListarAsignaturas</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>ObtenerProgreso</servlet-name>
        <servlet-class>controlador.MostrarPerfil</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ObtenerProgreso</servlet-name>
        <url-pattern>/ObtenerProgreso</url-pattern>
    </servlet-mapping>
</web-app>
